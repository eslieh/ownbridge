# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL) ---
DATABASE_CONNECTION_STRING="postgresql://USER:PASSWORD@HOST:5432/ownbridge?sslmode=require"

# --- Auth ---
# Long random string used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="REPLACE_WITH_RANDOM_32+_CHAR_SECRET"

# Owner account created by `pnpm db:seed` (change the password after first login)
OWNER_EMAIL="owner@ownbridge.co.ke"
OWNER_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# --- Cloudinary (image storage) --- https://console.cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"
# Upload preset (Settings → Upload → Upload presets). Set its folder there, e.g. ownbridge/listings.
CLOUDINARY_UPLOAD_PRESET="YOUR_UPLOAD_PRESET"

# --- Public site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp number in international format, digits only (no +, no spaces), e.g. 254712345678
NEXT_PUBLIC_WHATSAPP_NUMBER="2547XXXXXXXX"
# Social links (leave TikTok empty until the account is ready — it will be hidden)
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/"
NEXT_PUBLIC_X_URL="https://x.com/"
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_CONTACT_EMAIL="info@ownbridge.co.ke"
NEXT_PUBLIC_CONTACT_PHONE="+254 7XX XXX XXX"
